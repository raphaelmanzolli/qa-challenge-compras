# Valores LOCAIS de demonstracao. Nao use estes segredos em ambiente publico.
# Para customizar: cp .env.example .env  (e edite)

APP_PORT=8080

POSTGRES_DB=compras
POSTGRES_USER=compras
POSTGRES_PASSWORD=compras-local

JWT_SECRET=segredo-local-somente-demonstracao-troque-me-0123456789
JWT_TTL_MINUTES=120

# Senha dos usuarios comprador, fornecedor.a e fornecedor.b
DEMO_PASSWORD=DesafioQA@2026

# Tempo entre publicacao e abertura, e duracao da disputa (segundos).
# Aumente a duracao para testes de carga de escrita (ex.: 600).
DISPUTE_OPEN_DELAY_SECONDS=10
DISPUTE_DURATION_SECONDS=45
FRONTEND_POLL_INTERVAL_MS=2000
